# EVCOWBBE only. Import this file from the existing /etc/caddy/Caddyfile.
# Cloudflare orange-cloud traffic ONLY; non-Cloudflare origin traffic is denied.
# CIDRs verified against https://www.cloudflare.com/ips-v4 and /ips-v6
# on 2026-10-26. Recheck these ranges when Cloudflare changes its list.
dev-evcowbbe.transev.site {
    @fromCloudflare {
        remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22
        remote_ip 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
        header CF-Connecting-IP
    }

    header Cache-Control "no-store"

    handle @fromCloudflare {
        reverse_proxy 127.0.0.1:18280 {
            # The real Go peer must be loopback. Go rejects this header from
            # non-loopback peers. Only verified CF egress may supply it here.
            header_up X-Real-IP {http.request.header.Cf-Connecting-Ip}
            header_up -CF-Connecting-IP
        }
    }
    handle {
        respond "Forbidden" 403
    }
}
