#!/usr/bin/env bash
# Fixed, unprivileged builder for the separately approved root bridge.
set -euo pipefail
[[ $# -eq 1 && $1 =~ ^[0-9a-f]{40}$ ]] || exit 2
[[ $(id -un) == evcow-builder ]] || exit 2
sha=$1
# These invariants belong to the installed builder, not its caller's shell.
# Do not fetch missing dependencies or rewrite the candidate's go.mod/go.sum.
export GOTOOLCHAIN=local GOPROXY=off GOSUMDB=off GOWORK=off
export GOFLAGS=-mod=readonly GIT_TERMINAL_PROMPT=0
umask 077
source_dir=/srv/evcowbbe/source
work=/srv/evcowbbe/build-work
prepared=$work/prepared
[[ -d $source_dir && ! -L $source_dir && -d $work && ! -L $work ]] || exit 2
[[ ! -e $prepared/$sha && ! -L $prepared/$sha ]] || { echo 'build output already exists; inspect before retry' >&2; exit 2; }
mkdir -p -- "$prepared"
tmp=$(mktemp -d "$work/.build-$sha-XXXXXXXX")
cleanup() { rm -rf -- "$tmp"; }
trap cleanup EXIT
git -C "$source_dir" cat-file -e "$sha^{commit}"
git clone -q --no-checkout --local --no-hardlinks "$source_dir" "$tmp/source"
git -C "$tmp/source" checkout --quiet --detach "$sha"
[[ $(git -C "$tmp/source" rev-parse HEAD) == "$sha" ]] || exit 2
[[ -z $(git -C "$tmp/source" status --porcelain --untracked-files=all) ]] || exit 2
# A dependency-cache miss is a blocker. Dependency prefetch is a separate,
# supervised evcow-builder operation; never allow implicit network downloads.
(cd "$tmp/source" && go mod verify)
mkdir "$tmp/output"
bash "$tmp/source/scripts/build-release.sh" \
  --server-output "$tmp/output/evcowbbe" \
  --migrator-output "$tmp/output/evcowbbe-migrate" \
  --version '0.0.0'
[[ -x $tmp/output/evcowbbe && -x $tmp/output/evcowbbe-migrate ]] || exit 2
# Inspect the real -X-injected Go string symbol and module package identities.
# `go version -m` alone cannot observe linker -X variable values.
GO111MODULE=off go run \
  /opt/evcowbbe-deploy/current/ops/deploy/vps/release_identity.go \
  "$tmp/output/evcowbbe" "$tmp/output/evcowbbe-migrate" "$sha"
"$tmp/output/evcowbbe-migrate" verify --files-only
# Fail closed if Go tooling or the candidate's build script changed the source.
[[ -z $(git -C "$tmp/source" status --porcelain --untracked-files=all) ]] || {
  echo 'candidate source changed during build' >&2
  exit 2
}
chmod 0750 "$tmp/output" "$tmp/output/evcowbbe" "$tmp/output/evcowbbe-migrate"
mv -T -- "$tmp/output" "$prepared/$sha"
echo 'paired build published for privileged verification'
