# Fill using: pwsh -NoProfile -File .\scripts\configure.ps1
# No Docker, containers, local PostgreSQL installation or Mailpit required.
# Keep .env private. It is gitignored. Existing peppers must be retained.
APP_ENV=development
HTTP_LISTEN_ADDR=127.0.0.1:18080
PUBLIC_BASE_URL=http://127.0.0.1:18080
# A real, dedicated existing PostgreSQL database. Percent-encode special password characters.
DATABASE_URL=REPLACE_WITH_POSTGRES_URL
DB_MAX_CONNS=10
PASSWORD_PEPPER=REPLACE_WITH_GENERATED_SECRET
OTP_HMAC_PEPPER=REPLACE_WITH_GENERATED_SECRET
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
SESSION_ABSOLUTE_TTL_SECONDS=7776000
PASSWORD_ARGON2_MEMORY_KIB=65536
PASSWORD_ARGON2_ITERATIONS=3
PASSWORD_ARGON2_PARALLELISM=1
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
RATE_AUTH_PER_MINUTE=10
RATE_OTP_SEND_PER_HOUR=6
RATE_REFRESH_PER_MINUTE=12
MAIL_PROVIDER=SMTP
SMTP_HOST=REPLACE_WITH_SMTP_HOST
SMTP_PORT=587
SMTP_TLS_MODE=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=REPLACE_WITH_VERIFIED_FROM_EMAIL
MAIL_FROM_NAME=Charger on Wheels
