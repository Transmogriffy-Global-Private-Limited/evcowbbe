# development permits BUILD_REVISION=dev and an unlinked local binary.
# staging and production require BUILD_REVISION to equal the exact Git SHA
# embedded by scripts/build-release.sh.
APP_ENV=development
HTTP_LISTEN_ADDR=127.0.0.1:18080
DATABASE_URL=
LOG_LEVEL=INFO
PUBLIC_BASE_URL=https://localhost
# Runtime intended revision. This is not a build ldflag and is checked at startup.
BUILD_REVISION=dev
DEFAULT_TIMEZONE=Asia/Kolkata
SHUTDOWN_TIMEOUT_SECONDS=30
